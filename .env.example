# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres — pooled connection string (host contains "-pooler")
DATABASE_URI=
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Cloudflare R2 (S3 API token scoped to this bucket: Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket, no trailing slash.
# Spike: the r2.dev URL. Launch: custom domain, e.g. https://media.<domain>
R2_PUBLIC_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=

# Email provider — not chosen yet (Phase 4)
# Umami analytics — Phase 4
